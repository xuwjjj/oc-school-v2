# ── إعدادات الخادم ─────────────────────────────────────────────
PORT=4000
CLIENT_URL=http://localhost:5173

# أصول إضافية مسموحة (اختياري) — افصل بينها بفاصلة
# ALLOWED_ORIGINS=https://your-site.netlify.app

# ── الأمان ────────────────────────────────────────────────────
# سر توقيع الجلسات: 32 حرفاً على الأقل، عشوائي، ولا تشاركه مع أحد
JWT_SECRET=CHANGE_ME_use_a_long_random_string_at_least_32_chars

# ── حساب المشرف (يُنشأ تلقائياً عند أول تشغيل) ─────────────────
# استخدم 8 أحرف على الأقل تحتوي حرفاً ورقماً
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_strong_password
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=المشرف العام

# ── بوت تيليجرام (اختياري) ────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
